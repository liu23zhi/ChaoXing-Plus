# Shell/CMD scripts use LF; Windows Script Host files keep CRLF.
*.sh text eol=lf
*.cmd text eol=lf
# GBK Chinese batch input requires CRLF for cmd.exe's multibyte line parser.
windows/native-source/build-windows.cmd text eol=crlf
*.vbs text eol=crlf
tests/private-clients/*.exe filter=lfs diff=lfs merge=lfs -text
